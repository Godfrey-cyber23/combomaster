# Application
APP_ENV=local
APP_URL=http://localhost/combomaster
APP_DEBUG=true

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=combomaster_fitness
DB_USERNAME=combomaster_app
DB_PASSWORD=change-me
DB_MIGRATION_USERNAME=combomaster_migrator
DB_MIGRATION_PASSWORD=change-me

# Authentication
SESSION_NAME=combomaster_session
SESSION_LIFETIME=3600
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Email provider
MAIL_FROM_ADDRESS=noreply@combomaster.com
MAIL_FROM_NAME=ComboMaster Fitness
MAIL_API_KEY=

# Firebase Admin SDK
FIREBASE_SERVICE_ACCOUNT_PATH=
